# Radarr / Sonarr export configuration.
# Copy to .env and fill in real values. .env is gitignored.

# === RADARR ===
RADARR_URL=http://radarr.example.com
RADARR_API_KEY=replace-me

# === SONARR ===
SONARR_URL=http://sonarr.example.com
SONARR_API_KEY=replace-me

# === EXPORT ===
# Where dumped JSON lands. Relative to repo root. Gitignored.
EXPORT_DIR=exports
